{
  "name": "@dataflow/ws-server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "main": "dist/src/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "migrate:project-thumbnails": "tsx src/scripts/migrate-project-thumbnails.ts",
    "migrate:project-thumbnails:dry": "tsx src/scripts/migrate-project-thumbnails.ts --dry-run"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.31.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.3",
    "multer": "^2.1.1",
    "pg": "^8.18.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^7.0.11",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.16.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3"
  }
}
